# Copy to .env and fill in. .env is git-ignored.

HELPDESK_BASE_URL=
HELPDESK_API_KEY=
CANDIDATE_EMAIL=

# --- Model ---
# Written as provider:model. The NVIDIA model ids are listed on build.nvidia.com.
MODEL=nvidia:nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_API_KEY=
# The NVIDIA library otherwise sends hourly usage counts (no content) to NVIDIA.
NVIDIA_USAGE_TELEMETRY_ENABLED=false

# low, medium or high for models that accept it; empty uses the model's own default.
REASONING_EFFORT=low
# 0 gives the most repeatable decisions.
LLM_TEMPERATURE=0

# --- Agent behaviour ---
# A reply whose confidence is below this becomes a handoff.
CONFIDENCE_MIN=0.7
# Longer ticket bodies are cut here and handed to a human.
MAX_BODY_CHARS=6000
# Tickets handled at the same time, each on its own thread. The helpdesk calls of all threads together stay
# under four a second; the model API's rate limit is the real ceiling.
WORKERS=4
